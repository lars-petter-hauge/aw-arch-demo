# Copy this file to .env for local testing
# In Codespaces, docker-compose will work without explicit env vars

# AMQP Broker (RabbitMQ local)
BROKER_URL=amqp://guest:guest@rabbitmq:5672/

# Redis result cache
RESULT_CACHE_URL=redis://redis:6379

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
